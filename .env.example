# 智能化认知诊断系统 MVP — 环境变量模板
# 复制本文件为 .env 并按需填写（详见 README「环境变量」一节）

# SQLite 数据库路径（可选）
DIAGNOSIS_DB=data/diagnosis.db

# DINA 题目参数（可选）：失误率 / 猜测率
DINA_SLIP=0.1
DINA_GUESS=0.2

# DeepSeek API Key（用于 LLM 学习建议；留空则走模板降级）
DEEPSEEK_API_KEY=

# DeepSeek 接口地址与模型（可选，默认如下）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
